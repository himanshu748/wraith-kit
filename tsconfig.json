{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "scripts",
    "api",
    "tests",
    "*.ts",
    "eslint.config.js",
    "skeleton/**/*.ts",
    "apps/**/*.ts"
  ]
}
