{
  "name": "wraith-kit",
  "version": "0.0.0",
  "private": true,
  "description": "A lean TypeScript skeleton for small event agents that ask before they act. Built for the Kiroween 2026 hackathon (Skeleton Crew).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:fast": "WRAITH_PBT_RUNS=20 vitest run",
    "guard": "echo '{\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"execute_bash\",\"tool_input\":{\"command\":\"git commit -m guard-run-by-hand\"}}' | node scripts/hooks/commit-guard.mjs",
    "spec:trace": "node scripts/hooks/spec-trace.mjs --strict"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
