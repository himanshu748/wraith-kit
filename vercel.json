{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && ./node_modules/.bin/esbuild scripts/vercel-todo.ts --bundle --platform=node --target=node22 --format=esm --external:@vercel/blob --outfile=scripts/vercel-todo-bundle.mjs",
  "buildCommand": "npm run typecheck && mkdir -p public",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/todo",
      "transforms": [
        {
          "type": "request.query",
          "op": "set",
          "target": { "key": "_wraithRoute" },
          "args": "/$1"
        }
      ]
    }
  ]
}
