# Optional. The no-key local demo needs none of these except the default provider.
# Node's --env-file=.env can load a copy; never commit your .env.
WRAITH_LLM_PROVIDER=none
WRAITH_OPEN_BROWSER=1
# WRAITH_OWNER=your-github-handle
# WRAITH_GITHUB_REPO=your-handle/your-dedicated-sandbox
# WRAITH_GITHUB_TOKEN=
# WRAITH_WEBHOOK_SECRET=
# Live issue creation requires this explicit switch AND an approval in the UI.
WRAITH_LIVE_ISSUES=0
# WRAITH_NOTICE_CONFIG=apps/notice-ghoul/config.json
# WRAITH_LLM_BASE_URL=https://your-endpoint.example/v1/
# WRAITH_LLM_MODEL=your-endpoint-name
# WRAITH_LLM_KEY=
# Local Ollama only: http://127.0.0.1:11434/v1/, downloaded model, cloud disabled.
WRAITH_OLLAMA_LOCAL_CONFIRMED=0
# WRAITH_CONFIG_DIR must be outside the repository, owner-only.
# WRAITH_CONFIG_DIR=/absolute/private/config-directory
# WRAITH_DATA_DIR=/absolute/path/to/.wraith/app
